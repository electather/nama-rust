// Fallow: unused code and dependencies, duplication, complexity and import boundaries.
// `vp run fallow` runs `fallow --ci`. See web/README.md, "Checks".
{
  "$schema": "https://fallow.tools/schema.json",
  // Generated code: `buf generate` writes src/gen/, the router plugin writes the route tree.
  "ignorePatterns": ["src/gen/**", "src/routeTree.gen.ts"],
  // shadcn files export every sub-part of a component, used or not.
  "ignoreExports": [{ "file": "src/shared/ui/**", "exports": ["*"] }],
  // Run by `buf generate` in proto/, never imported.
  "ignoreDependencies": ["@bufbuild/protoc-gen-es"],
  // web/src/AGENTS.md, "File size". Fallow sets limits by glob, not by zone.
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 15,
    "maxFileLines": 200,
    "thresholdOverrides": [
      {
        "files": ["src/**/__tests__/**"],
        "maxFileLines": 400,
        "reason": "A test file holds a feature's cases and the fixtures they share.",
      },
      {
        "files": ["vite.config.ts"],
        "maxFileLines": 0,
        "reason": "All format, lint and test config lives in it (web/AGENTS.md, \"Only `vp`\").",
      },
      {
        // Each file leaves this list when it moves into the feature layout.
        "files": [
          "src/access.test.tsx",
          "src/browse.test.tsx",
          "src/choose-quality.test.tsx",
          "src/components/code-sign-in.tsx",
          "src/components/delete-media.tsx",
          "src/components/edit-images.tsx",
          "src/components/image-store.tsx",
          "src/components/permissions-editor.tsx",
          "src/components/player.tsx",
          "src/components/plugin-at-a-glance.tsx",
          "src/components/plugin-qualities.tsx",
          "src/components/plugin-toggle.tsx",
          "src/components/recognisers-field.tsx",
          "src/components/request-actions.tsx",
          "src/components/request-row.tsx",
          "src/components/season-picker.tsx",
          "src/components/setting-fields.tsx",
          "src/components/title-list-controls.tsx",
          "src/components/title-sources-field.tsx",
          "src/components/track-preferences.tsx",
          "src/components/unmatched-item.tsx",
          "src/delete-from-show.test.tsx",
          "src/delete-media.test.tsx",
          "src/edit-images.test.tsx",
          "src/find-a-movie.test.tsx",
          "src/image-store.test.tsx",
          "src/lib/events.ts",
          "src/lib/playback-plan.ts",
          "src/lib/playback-wording.ts",
          "src/lib/playback.ts",
          "src/lib/subtitles.ts",
          "src/library-recognisers.test.tsx",
          "src/library-title-sources.test.tsx",
          "src/manage-requests.test.tsx",
          "src/permissions.test.tsx",
          "src/player-ass.test.tsx",
          "src/player-burn-in.test.tsx",
          "src/player-info.test.tsx",
          "src/player-keep-alive.test.tsx",
          "src/player-limit.test.tsx",
          "src/player-next-episode.test.tsx",
          "src/player-pgs.test.tsx",
          "src/player-subtitles.test.tsx",
          "src/player.test.tsx",
          "src/plugin-settings.test.tsx",
          "src/plugins.test.tsx",
          "src/request-state-filter.test.tsx",
          "src/requests.test.tsx",
          "src/routes/_member/libraries/$libraryId/shows/$showId/index.tsx",
          "src/season-picker.test.tsx",
          "src/sign-in-code.test.tsx",
          "src/test-plugins.tsx",
          "src/title-page.test.tsx",
          "src/users.test.tsx",
          "src/watch-state.test.tsx",
        ],
        "maxFileLines": 400,
        "reason": "#1133: written before the feature layout, and split as it moves there.",
      },
    ],
  },
  // web/src/AGENTS.md, "Layers". src/gen/ is ignored above, and protoc-gen-es only imports
  // @bufbuild/protobuf, so it needs no zone. A file is in the first zone that matches it.
  "boundaries": {
    "zones": [
      { "name": "shared-ui", "patterns": ["src/shared/ui/**"] },
      { "name": "shared-components", "patterns": ["src/shared/components/**"] },
      { "name": "shared-hooks", "patterns": ["src/shared/hooks/**"] },
      { "name": "shared-lib", "patterns": ["src/shared/lib/**"] },
      { "name": "admin-needs-a-match", "patterns": ["src/features/admin-needs-a-match/**"] },
      { "name": "admin-playback", "patterns": ["src/features/admin-playback/**"] },
      { "name": "invites", "patterns": ["src/features/invites/**"] },
      { "name": "app", "patterns": ["src/app/**"] },
      { "name": "routes", "patterns": ["src/routes/**"] },
      // The only files that import route files.
      { "name": "router", "patterns": ["src/main.tsx", "src/router.tsx", "src/routeTree.gen.ts"] },
      // Code not yet moved into the feature layout (#1133). A18 (#1150) removes these zones.
      { "name": "legacy-components", "patterns": ["src/components/**"] },
      { "name": "legacy-lib", "patterns": ["src/lib/**"] },
    ],
    // Each feature PR adds its feature's zone, allowed `shared-*` and the sibling features it
    // lists, and adds the feature to `app`, `routes` and `router`. While the move runs, every zone
    // may also import the legacy ones.
    "rules": [
      {
        "from": "shared-lib",
        "allow": ["shared-lib", "legacy-components", "legacy-lib"],
      },
      {
        "from": "shared-hooks",
        "allow": ["shared-hooks", "shared-lib", "legacy-components", "legacy-lib"],
      },
      {
        "from": "shared-ui",
        "allow": ["shared-ui", "legacy-components", "legacy-lib"],
      },
      {
        "from": "shared-components",
        "allow": [
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "admin-needs-a-match",
        "allow": [
          "admin-needs-a-match",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "admin-playback",
        "allow": [
          "admin-playback",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "invites",
        "allow": [
          "invites",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "app",
        "allow": [
          "app",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "routes",
        "allow": [
          "app",
          "admin-needs-a-match",
          "admin-playback",
          "invites",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "router",
        "allow": [
          "router",
          "routes",
          "app",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
          "legacy-components",
          "legacy-lib",
        ],
      },
      {
        "from": "legacy-components",
        "allow": [
          "legacy-components",
          "legacy-lib",
          "shared-components",
          "shared-ui",
          "shared-hooks",
          "shared-lib",
        ],
      },
      { "from": "legacy-lib", "allow": ["legacy-lib", "shared-hooks", "shared-lib"] },
    ],
  },
  // web/src/AGENTS.md: data hooks, Suspense and dynamic loading, in the new folders only.
  "rulePacks": ["fallow-rules.jsonc"],
  // Every rule fails the run. `coverage-gaps` needs the runtime coverage sidecar, which CI
  // doesn't run.
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "deprecated-exports-in-use": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-namespace-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "absent-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "complexity-file-lines": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unlisted-binaries": "error",
    "duplicate-exports": "error",
    "duplicate-export-aliases": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "package-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "off",
    "feature-flags": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
    "weakened-tests": "error",
    "added-suppression": "error",
    "test-only-branch": "error",
    "diverged-clone-sibling": "error",
    "added-dependency": "error",
  },
}
