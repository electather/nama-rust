// Fallow: unused code and dependencies, duplication, complexity and import boundaries.
// `vp run fallow` runs `fallow --ci`. See web/README.md, "Checks".
{
  "$schema": "https://fallow.tools/schema.json",
  // Generated code: `buf generate` writes src/gen/, the router plugin the route tree.
  "ignorePatterns": ["src/gen/**", "src/routeTree.gen.ts"],
  // nama-ui's package exports make every component an entry point, so this is what still fails a
  // component, or a sub-part, that no screen uses (ui/src/components/AGENTS.md).
  "workspaces": { "settings": { "ui": { "includeEntryExports": true } } },
  // Run by `buf generate` in proto/, never imported.
  "ignoreDependencies": ["@bufbuild/protoc-gen-es"],
  // web/AGENTS.md, "File size". Fallow sets limits by glob, not by zone.
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 15,
    "maxFileLines": 200,
    "thresholdOverrides": [
      {
        "files": ["**/__tests__/**"],
        "maxFileLines": 400,
        "reason": "A test file holds a feature's cases and the fixtures they share.",
      },
      {
        "files": ["src/shared/lib/playback-wording.ts"],
        "maxFileLines": 220,
        "reason": "A sentence for each Playback Reason kind, a table that grows with the schema's `PlaybackReasonKind`.",
      },
      {
        "files": ["vite.config.ts"],
        "maxFileLines": 0,
        "reason": "All format, lint and test config lives in it (web/AGENTS.md, \"Only `vp`\").",
      },
    ],
  },
  // web/src/AGENTS.md, "Layers". src/gen/ is ignored above, and protoc-gen-es only imports
  // @bufbuild/protobuf, so it needs no zone. A file is in the first zone that matches it.
  "boundaries": {
    "zones": [
      { "name": "shared-components", "patterns": ["src/shared/components/**"] },
      { "name": "shared-hooks", "patterns": ["src/shared/hooks/**"] },
      { "name": "shared-lib", "patterns": ["src/shared/lib/**"] },
      { "name": "auth", "patterns": ["src/features/auth/**"] },
      { "name": "admin-plugins", "patterns": ["src/features/admin-plugins/**"] },
      { "name": "admin-libraries", "patterns": ["src/features/admin-libraries/**"] },
      { "name": "admin-needs-a-match", "patterns": ["src/features/admin-needs-a-match/**"] },
      { "name": "admin-playback", "patterns": ["src/features/admin-playback/**"] },
      { "name": "admin-jobs", "patterns": ["src/features/admin-jobs/**"] },
      { "name": "admin-backups", "patterns": ["src/features/admin-backups/**"] },
      { "name": "admin-now-playing", "patterns": ["src/features/admin-now-playing/**"] },
      { "name": "admin-home", "patterns": ["src/features/admin-home/**"] },
      { "name": "admin-users", "patterns": ["src/features/admin-users/**"] },
      { "name": "requests", "patterns": ["src/features/requests/**"] },
      { "name": "inbox", "patterns": ["src/features/inbox/**"] },
      { "name": "action-bar", "patterns": ["src/features/action-bar/**"] },
      { "name": "invites", "patterns": ["src/features/invites/**"] },
      { "name": "settings", "patterns": ["src/features/settings/**"] },
      { "name": "home", "patterns": ["src/features/home/**"] },
      { "name": "library", "patterns": ["src/features/library/**"] },
      { "name": "title", "patterns": ["src/features/title/**"] },
      { "name": "player", "patterns": ["src/features/player/**"] },
      { "name": "servers", "patterns": ["src/features/servers/**"] },
      { "name": "watchlist", "patterns": ["src/features/watchlist/**"] },
      { "name": "app", "patterns": ["src/app/**"] },
      { "name": "routes", "patterns": ["src/routes/**"] },
      // The only files that import route files.
      { "name": "router", "patterns": ["src/main.tsx", "src/router.tsx", "src/routeTree.gen.ts"] },
    ],
    // Each feature PR adds its feature's zone, allowed `shared-*` and the sibling features it
    // lists, and adds the feature to `app`, `routes` and `router`.
    "rules": [
      {
        "from": "shared-lib",
        "allow": ["shared-lib"],
      },
      {
        "from": "shared-hooks",
        "allow": ["shared-hooks", "shared-lib"],
      },
      {
        "from": "shared-components",
        "allow": ["shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "auth",
        // Home at the Hub lists its Servers' Libraries under their merged rows.
        "allow": ["auth", "home", "servers", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-libraries",
        "allow": ["admin-libraries", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-plugins",
        "allow": ["admin-plugins", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-needs-a-match",
        "allow": ["admin-needs-a-match", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-playback",
        "allow": ["admin-playback", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-jobs",
        "allow": ["admin-jobs", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-backups",
        "allow": ["admin-backups", "admin-jobs", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-now-playing",
        "allow": ["admin-now-playing", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-home",
        "allow": ["admin-home", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "admin-users",
        "allow": ["admin-users", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "invites",
        "allow": ["invites", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "requests",
        "allow": ["requests", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "inbox",
        // A notification opens Settings at the User's Requests.
        "allow": ["inbox", "settings", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "action-bar",
        // Its Settings and Admin pages open Settings at a section. At the Hub, its search reaches
        // the Account's Servers as their Libraries' list does.
        "allow": [
          "action-bar",
          "settings",
          "servers",
          "shared-components",
          "shared-hooks",
          "shared-lib",
        ],
      },
      {
        "from": "settings",
        // Its Plugins, Default Home and Users panes render the admin features' parts (Users also renders Invites'); its Backups pane renders Backups' parts,
        // and each Backup's row says when it was written as a Job's Run does. Its Libraries, Needs a Match, Now Playing and Jobs panes render those features' parts. Its Devices pane signs in another Device with the Sign-in Code parts of `/code`. Its Requests pane lists the User's Requests. At the Hub, it reaches the Servers it picks from as their Libraries' list does.
        "allow": [
          "settings",
          "servers",
          "requests",
          "admin-plugins",
          "admin-home",
          "admin-users",
          "invites",
          "admin-playback",
          "admin-backups",
          "admin-jobs",
          "admin-needs-a-match",
          "admin-now-playing",
          "admin-libraries",
          "auth",
          "shared-components",
          "shared-hooks",
          "shared-lib",
        ],
      },
      {
        "from": "home",
        // At the Hub, Home merges the rows of the Servers it reaches as their Libraries' list does.
        "allow": ["home", "servers", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "library",
        "allow": ["library", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "title",
        // At the Hub, Play reaches the Account's other Servers as their Libraries' list does.
        "allow": ["title", "servers", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "player",
        "allow": ["player", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "servers",
        "allow": ["servers", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "watchlist",
        // At the Hub, it reaches each of the Account's Servers as their Libraries' list does.
        "allow": ["watchlist", "servers", "shared-components", "shared-hooks", "shared-lib"],
      },
      {
        "from": "app",
        // A Server's pages at the Hub confirm it's you by signing in on the Hub again.
        "allow": [
          "app",
          "action-bar",
          "auth",
          "inbox",
          "player",
          "settings",
          "shared-components",
          "shared-hooks",
          "shared-lib",
        ],
      },
      {
        "from": "routes",
        "allow": [
          "app",
          "auth",
          "admin-playback",
          "invites",
          "requests",
          "action-bar",
          "settings",
          "home",
          "library",
          "title",
          "player",
          "servers",
          "watchlist",
          "shared-components",
          "shared-hooks",
          "shared-lib",
        ],
      },
      {
        "from": "router",
        "allow": ["router", "routes", "app", "shared-components", "shared-hooks", "shared-lib"],
      },
    ],
  },
  // web/src/AGENTS.md: data hooks, Suspense and dynamic loading, in src/app/, src/features/ and src/shared/.
  "rulePacks": ["fallow-rules.jsonc"],
  // Every rule fails the run. `coverage-gaps` needs the runtime coverage sidecar, which CI
  // doesn't run.
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "deprecated-exports-in-use": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-namespace-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "absent-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "complexity-file-lines": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unlisted-binaries": "error",
    "duplicate-exports": "error",
    "duplicate-export-aliases": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "package-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "off",
    "feature-flags": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
    "weakened-tests": "error",
    "added-suppression": "error",
    "test-only-branch": "error",
    "diverged-clone-sibling": "error",
    "added-dependency": "error",
  },
}
