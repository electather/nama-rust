# Copy to `.env` (git ignores it) for otel-grafana-cloud.yml. Both values come from your
# Grafana Cloud stack's OpenTelemetry tile: the endpoint, and the `Authorization=` header's value.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_CLOUD_OTLP_AUTH=Basic <token>
