  "query": "SELECT id AS \"id!\", tmdb_id, title, state, created_at, decline_reason\n           FROM followed_shows\n           WHERE (?1 IS NULL OR id = ?1)\n             AND (?2 IS NULL OR EXISTS (SELECT 1 FROM followed_show_requesters\n                                        WHERE followed_show_id = followed_shows.id\n                                          AND user_id = ?2))\n           ORDER BY id DESC",
