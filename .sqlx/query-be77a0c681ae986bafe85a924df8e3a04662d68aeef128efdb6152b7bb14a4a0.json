{
  "db_name": "SQLite",
  "query": "SELECT library_files.id AS \"file!\", library_files.path, library_files.size,\n                              library_files.modified_ns, library_files.parser_version,\n                              library_items.season AS \"season!\",\n                              library_items.episode AS \"episode!\",\n                              item_matches.plugin AS \"plugin!\", (SELECT json_group_object(namespace, value) FROM item_match_ids\n              WHERE item_match_ids.item_id = item_matches.item_id AND scope = 'title') AS \"ids?: String\", (SELECT json_group_object(namespace, value) FROM item_match_ids\n              WHERE item_match_ids.item_id = item_matches.item_id AND scope = 'show') AS \"show_ids?: String\",\n                              item_matches.title AS \"title!\",\n                              item_matches.show_title AS \"show_title!\",\n                              item_matches.overview, item_matches.release_date,\n                              item_matches.runtime_minutes, item_matches.poster,\n                              item_matches.backdrop, item_matches.still, libraries.title_sources\n                       FROM item_matches\n                       JOIN library_items ON library_items.id = item_matches.item_id\n                       JOIN library_files ON library_files.id = library_items.file_id\n                       JOIN libraries ON libraries.id = library_files.library_id\n                       WHERE library_files.library_id = ?\n                         AND library_items.kind = 'episode'\n                         AND item_matches.state = 'matched'\n                       ORDER BY library_items.season, library_items.episode, library_files.path",
