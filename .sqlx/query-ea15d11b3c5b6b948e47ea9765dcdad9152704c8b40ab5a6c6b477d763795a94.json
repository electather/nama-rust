  "query": "SELECT id AS \"id!\", tmdb_id, season AS \"season: u32\", title, release_date, state,\n                  created_at, decline_reason, failure_reason\n           FROM requests\n           WHERE (?1 IS NULL OR id = ?1)\n             AND (?2 IS NULL OR EXISTS (SELECT 1 FROM requesters\n                                        WHERE request_id = requests.id AND user_id = ?2))\n           ORDER BY id DESC",
