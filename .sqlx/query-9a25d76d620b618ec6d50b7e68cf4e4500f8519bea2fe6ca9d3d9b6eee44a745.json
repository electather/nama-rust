{
  "db_name": "SQLite",
  "query": "SELECT library_files.library_id AS library,\n                              library_items.kind AS \"kind: ItemKind\", library_items.season,\n                              library_items.episode, item_matches.plugin AS \"plugin!\", (SELECT json_group_object(namespace, value) FROM item_match_ids\n              WHERE item_match_ids.item_id = item_matches.item_id AND scope = 'title') AS \"ids?: String\", (SELECT json_group_object(namespace, value) FROM item_match_ids\n              WHERE item_match_ids.item_id = item_matches.item_id AND scope = 'show') AS \"show_ids?: String\", item_matches.title AS \"title!\",\n                              item_matches.show_title, item_matches.release_date,\n                              item_matches.poster\n                       FROM title_search\n                       JOIN item_matches ON item_matches.item_id = title_search.rowid\n                       JOIN library_items ON library_items.id = item_matches.item_id\n                       JOIN library_files ON library_files.id = library_items.file_id\n                       WHERE title_search MATCH ?\n                       ORDER BY title_search.rank",
