{
  "db_name": "SQLite",
  "query": "SELECT library_files.path, library_files.size, library_files.edition,\n                              library_items.id AS \"item?\", library_items.kind AS \"kind?: ItemKind\",\n                              library_items.title AS \"item_title?\", library_items.year,\n                              library_items.hint, library_items.season,\n                              library_items.episode,\n                              item_matches.state AS \"state?: MatchState\", item_matches.plugin, (SELECT json_group_object(namespace, value) FROM item_match_ids\n              WHERE item_match_ids.item_id = item_matches.item_id AND scope = 'title') AS \"ids?: String\", (SELECT json_group_object(namespace, value) FROM item_match_ids\n              WHERE item_match_ids.item_id = item_matches.item_id AND scope = 'show') AS \"show_ids?: String\", item_matches.title,\n                              item_matches.show_title, item_matches.poster\n                       FROM library_files\n                       LEFT JOIN library_items ON library_items.file_id = library_files.id\n                       LEFT JOIN item_matches ON item_matches.item_id = library_items.id\n                       WHERE library_files.library_id = ?\n                       ORDER BY library_files.path, library_items.id",
