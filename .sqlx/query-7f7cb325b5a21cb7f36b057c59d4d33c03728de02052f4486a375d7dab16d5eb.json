  "query": "SELECT account_sessions.id, accounts.id AS account_id, accounts.email\n         FROM account_sessions JOIN accounts ON accounts.id = account_sessions.account_id\n         WHERE token_hash = $1 AND account_sessions.created_at > now() - make_interval(days => $2)",
